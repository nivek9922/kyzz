generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum Role {
  admin
  user
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponCampaign {
  newsletter_welcome
  first_purchase
  seasonal
  influencer
  category
  free_shipping
  vip
  general
}

enum ShippingStatus {
  pending
  processing
  shipped
  delivered
  returned
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnType {
  EXCHANGE  // Cambio por talla correcta u otro producto
  REFUND    // Reembolso de dinero al cliente
}

enum PaymentGateway {
  paypal
  wompi
  manual
  cash
}

// Canal de venta — de dónde viene la orden (omnicanalidad)
enum SalesChannel {
  web
  whatsapp
  instagram
  other
}

// Método de pago elegido — prepago online vs contraentrega
enum PaymentMethod {
  prepaid
  cod
}

model Category {
  id            String    @id @default(uuid())
  name          String    @unique
  slug          String    @unique @default("")
  imageUrl      String?
  imageLightBg  Boolean   @default(false)
  Product       Product[]
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  inStock     Int
  price       Float    @default(0)
  sizes       Size[]   @default([])
  slug        String   @unique
  tags        String[] @default([])
  isFeatured  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  ProductImage  ProductImage[]
  OrderItem     OrderItem[]
  ProductColors ProductColor[]
  variants      ProductVariant[]
  WishlistItem  WishlistItem[]
  reviews       Review[]

  @@index([isFeatured])
  @@index([isArchived])
  @@index([categoryId])
}

model ProductImage {
  id  Int    @id @default(autoincrement())
  url String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

// Lista de deseos persistida por usuaria (sincroniza el wishlist local al loguearse)
model WishlistItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([userId, productId])
  @@index([userId])
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(user)
  image         String?

  address UserAddress?

  // Relaciones
  Order        Order[]
  WishlistItem WishlistItem[]
  reviews      Review[]
}

model Country {
  id   String @id
  name String

  UserAddress  UserAddress[]
  OrderAddress OrderAddress[]
}

model UserAddress {
  id         String  @id @default(uuid())
  firstName  String
  lastName   String
  address    String
  address2   String?
  postalCode String
  phone      String
  city       String

  // Relaciones
  country   Country @relation(fields: [countryId], references: [id])
  countryId String

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

// Order de compras
model Order {
  id           String    @id @default(uuid())
  subTotal     Float
  tax          Float
  total        Float
  itemsInOrder Int
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  cancelledAt  DateTime?

  channel       SalesChannel  @default(web)
  paymentMethod PaymentMethod @default(prepaid)

  // COD: el equipo confirma el pedido antes de despachar (anti-fraude).
  // Mientras no se confirme, la reserva de stock puede expirar y liberarse.
  codConfirmedAt       DateTime?
  reservationExpiresAt DateTime?

  shippingStatus ShippingStatus @default(pending)
  trackingCode   String?
  shippingNotes  String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user       User?   @relation(fields: [userId], references: [id])
  userId     String?
  guestEmail String?

  OrderItem    OrderItem[]
  OrderAddress OrderAddress?

  transactionId   String?
  paymentGateway  PaymentGateway?
  paymentProofUrl String?
  couponCode      String?
  couponDiscount  Float   @default(0)

  redemption    CouponRedemption?
  returnRequest ReturnRequest?

  @@index([userId])
  @@index([guestEmail])
  @@index([isPaid])
  @@index([paidAt])
  @@index([shippingStatus])
  @@index([channel])
  @@index([paymentMethod])
}

// Sesión de conversación de WhatsApp. Mantiene el paso actual y contexto entre
// mensajes. Expira tras 30 min de inactividad; el motor de flujos la reinicia.
model WhatsAppSession {
  id        String   @id @default(uuid())
  phone     String   @unique
  step      String   @default("idle")
  context   Json?
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([phone])
  @@index([expiresAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Float
  size      Size
  colorName String?

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?

  @@index([orderId])
  @@index([productId])
}

model ColorPalette {
  id            String         @id @default(uuid())
  name          String         @unique
  hex           String
  sortOrder     Int            @default(0)
  productColors ProductColor[]
}

model ProductColor {
  id             String              @id @default(uuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  paletteColorId String
  paletteColor   ColorPalette        @relation(fields: [paletteColorId], references: [id])
  images         ProductColorImage[]
  variants       ProductVariant[]

  @@unique([productId, paletteColorId])
}

model ProductColorImage {
  id             String       @id @default(uuid())
  url            String
  sortOrder      Int          @default(0)
  productColorId String
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

// Variante vendible: combinación (producto × color? × talla) con stock propio
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  colorId String?
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: Cascade)

  size  Size
  stock    Int     @default(0) // unidades físicas en bodega
  reserved Int     @default(0) // comprometidas por órdenes activas (available = stock - reserved)
  sku   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  OrderItem OrderItem[]

  @@unique([productId, colorId, size])
  @@index([productId])
  @@index([colorId])
}

model SiteConfig {
  id                 String   @id @default("main")
  heroTitle          String   @default("Kyzz: Basics for every you")
  heroSubtitle       String   @default("Nueva colección")
  heroCta            String   @default("Explorar colección")
  heroImageUrl       String?
  heroVideoUrl       String?
  heroPosterUrl      String?
  brandStoryImageUrl String?
  brandStoryText     String?
  updatedAt          DateTime @updatedAt
}

model Subscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  source         String    @default("newsletter-popup")
  isActive       Boolean   @default(true)
  receivedCoupon Boolean   @default(false)
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  welcomeCouponId String?
  welcomeCoupon   Coupon? @relation(fields: [welcomeCouponId], references: [id])
}

model Coupon {
  id             String         @id @default(uuid())
  code           String         @unique
  type           CouponType     @default(PERCENTAGE)
  value          Float
  isActive       Boolean        @default(true)
  subscriberOnly Boolean        @default(false)
  campaign       CouponCampaign @default(general)
  description    String?
  minimumAmount  Float?
  usageLimit     Int?
  usageCount     Int            @default(0)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  redemptions  CouponRedemption[]
  subscribers  Subscriber[]
}

model CouponRedemption {
  id         String   @id @default(uuid())
  email      String
  redeemedAt DateTime @default(now())

  coupon   Coupon @relation(fields: [couponId], references: [id])
  couponId String

  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String? @unique

  @@unique([couponId, email])
  @@index([email])
}

model OrderAddress {
  id         String  @id @default(uuid())
  firstName  String
  lastName   String
  address    String
  address2   String?
  postalCode String
  city       String
  phone      String

  // Relaciones
  country   Country @relation(fields: [countryId], references: [id])
  countryId String

  Order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique
}

// ── Reseñas de producto ────────────────────────────────────────────────────────
model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1-5
  comment   String?  @db.VarChar(600)
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([userId, productId])
  @@index([productId])
}

// ── Carrito abandonado ─────────────────────────────────────────────────────────
model AbandonedCart {
  id            String    @id @default(uuid())
  email         String
  items         Json      // instantánea de CartProductType[]
  recoveryToken String    @unique @default(uuid())
  emailSentAt   DateTime?
  recoveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
}

// ── Solicitudes de devolución / RMA ───────────────────────────────────────────
model ReturnRequest {
  id              String       @id @default(uuid())
  reason          String
  details         String?      @db.VarChar(1000)
  status          ReturnStatus @default(PENDING)
  adminNotes      String?      // solo visible para admin, nunca al cliente
  customerMessage String?      // se envía en el email al cliente

  // Resolución acordada (se define al APPROVED o COMPLETED)
  returnType    ReturnType?  // EXCHANGE = cambio, REFUND = reembolso
  refundAmount  Float?       // Monto a devolver (solo para REFUND)
  refundMethod  String?      // Ej: "Nequi 3001234567", "Bancolombia TXN-xxx", "Efectivo"
  proofImageUrl String?      // Foto del defecto/daño (sube el admin)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique

  @@index([status])
}
