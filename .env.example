
# ─────────────────────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL via Docker)
# ─────────────────────────────────────────────────────────────
# Cadena de conexión completa para Prisma.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# IMPORTANTE: el docker-compose expone el puerto 5436 (no 5432)
DATABASE_URL="postgresql://postgres:password@localhost:5436/kyzz-shop"

# Variables auxiliares usadas por docker-compose.yml
DB_USER=postgres
DB_NAME=kyzz-shop
DB_PASSWORD=password

# ─────────────────────────────────────────────────────────────
# NEXT AUTH v5
# ─────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT.
# Genera una con: openssl rand -base64 32
AUTH_SECRET="REEMPLAZA_CON_TU_SECRETO"
AUTH_TRUST_HOST=true

# URL base de tu aplicación (sin trailing slash).
# En producción: https://tu-dominio.com
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# GOOGLE OAUTH (opcional pero recomendado)
# ─────────────────────────────────────────────────────────────
# Credenciales desde: https://console.cloud.google.com
# Pasos: APIs & Services > Credentials > Create OAuth 2.0 Client ID
#
# Authorized redirect URIs:
#   Dev:  http://localhost:3000/api/auth/callback/google
#   Prod: https://tu-dominio.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─────────────────────────────────────────────────────────────
# WOMPI (pagos colombianos — principal gateway COP)
# ─────────────────────────────────────────────────────────────
# Credenciales en: https://dashboard.wompi.co → Desarrolladores → Llaves de API
#
# NEXT_PUBLIC_* es visible en el cliente (solo la llave pública, nunca la privada)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""          # pub_test_xxx  (sandbox)  | pub_prod_xxx (prod)

# Llaves de servidor — NUNCA usar prefijo NEXT_PUBLIC_ aquí
WOMPI_PRIVATE_KEY=""                     # prv_test_xxx  (sandbox)  | prv_prod_xxx (prod)

# Secreto de integridad — se usa para generar el hash SHA256 del Widget
# Dashboard → Desarrolladores → Integridad del comercio
WOMPI_INTEGRITY_SECRET=""               # test_integrity_xxx | prod_integrity_xxx

# Secreto de eventos — se usa para verificar la firma de cada webhook
# Dashboard → Desarrolladores → Eventos → Secreto de eventos
WOMPI_EVENTS_SECRET=""                  # test_events_xxx | prod_events_xxx

# URL base de la API de Wompi
#   Sandbox:    https://sandbox.wompi.co/v1
#   Producción: https://production.wompi.co/v1
WOMPI_BASE_URL="https://sandbox.wompi.co/v1"

# URL pública de la app — requerida para que Wompi funcione en desarrollo.
# El WAF de Wompi bloquea con 403 cuando redirect-url apunta a localhost.
# En dev: usa ngrok (`ngrok http 3000`) y pega la URL HTTPS aquí.
# En producción: dominio real sin trailing slash (ej. https://kyzz.co).
#NEXT_PUBLIC_APP_URL="https://xxx.ngrok-free.app"

# ─────────────────────────────────────────────────────────────
# URL canónica del sitio (SEO / metadataBase / Open Graph)
# ─────────────────────────────────────────────────────────────
# Se usa en src/app/layout.tsx para generar URLs absolutas de OG/Twitter.
# Si no está definida, cae a VERCEL_URL (que es el deploy preview, no el dominio).
# En producción: dominio canónico sin trailing slash (ej. https://kyzz.co).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# CLOUDINARY (almacenamiento de imágenes de productos)
# ─────────────────────────────────────────────────────────────
# Credenciales disponibles en: https://console.cloudinary.com → Dashboard
#
# Formato de CLOUDINARY_URL: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ─────────────────────────────────────────────────────────────
# EMAIL — Resend (transaccional)
# ─────────────────────────────────────────────────────────────
# API Key en: https://resend.com/api-keys
# Sin esta variable los emails se omiten silenciosamente (no rompe la app)
RESEND_API_KEY=""

# Remitente. En dev usa el sandbox (no requiere dominio verificado):
#   onboarding@resend.dev
# En prod con dominio verificado:
#   pedidos@kyzz.com
EMAIL_FROM="onboarding@resend.dev"

# Correo que recibe los mensajes del formulario de contacto.
# En producción: hola@kyzz.co (o el que uses con dominio verificado)
EMAIL_CONTACT="onboarding@resend.dev"

# ─────────────────────────────────────────────────────────────
# GOOGLE ANALYTICS 4 (opcional)
# ─────────────────────────────────────────────────────────────
# ID de medición desde: analytics.google.com → Tu propiedad → Flujos de datos
# Dejar vacío en dev para no contaminar datos de producción
NEXT_PUBLIC_GA_ID=""

# ─────────────────────────────────────────────────────────────
# VERCEL CRON (cancelación automática de órdenes impagas)
# ─────────────────────────────────────────────────────────────
# Secreto aleatorio para proteger el endpoint /api/cron/cancel-orders.
# Vercel lo inyecta automáticamente como header Authorization: Bearer <valor>.
# Genera uno con: openssl rand -base64 32
# En desarrollo puedes dejarlo vacío (el endpoint acepta cualquier request).
CRON_SECRET=""
